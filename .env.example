# ==============================================================================
# Configurações do Ambiente — Sistema Casa Vida
# ==============================================================================
# Copie este arquivo para ".env" na raiz do projeto (máquina local do instituto).
# IMPORTANTE: Nunca comite o arquivo ".env" nem arquivos .db no GitHub.

# ------------------------------------------------------------------------------
# Banco de Dados SQLite Local e Segurança
# ------------------------------------------------------------------------------
# Caminho do arquivo SQLite (relativo à raiz do projeto ou absoluto na máquina local).
# Por padrão usa "data/casa_vida.db", que é ignorado pelo .gitignore.
DATABASE_PATH=data/casa_vida.db

# Pasta onde as cópias de segurança (.db) são salvas (também ignorada pelo .gitignore).
BACKUPS_DIR=backups

# Chave secreta da aplicação Flask (sessões e flash messages).
# Se deixada vazia, uma chave aleatória é gerada automaticamente em data/.secret_key.
SECRET_KEY=

# ==============================================================================
# Configurações de Sincronização com Google Sheets
# ==============================================================================
# Preencha uma das opções abaixo para habilitar a sincronização com o Google Sheets.

# ------------------------------------------------------------------------------
# OPÇÃO 1 (Recomendada): URL CSV publicada diretamente da planilha
# ------------------------------------------------------------------------------
# Como obter:
#   1. Abra a planilha no Google Sheets.
#   2. Acesse: Arquivo > Compartilhar > Publicar na Web.
#   3. Escolha a aba desejada (ou "Documento inteiro") e o formato
#      "Valores separados por vírgula (.csv)".
#   4. Clique em "Publicar" e copie o link gerado para a variável abaixo.
#
# Exemplo:
#   GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?gid=0&single=true&output=csv
GOOGLE_SHEETS_CSV_URL=

# ------------------------------------------------------------------------------
# OPÇÃO 2: ID da planilha + GID da aba (para planilhas compartilhadas como leitura)
# ------------------------------------------------------------------------------
# Como obter o ID e o GID pela URL do navegador:
#   URL exemplo: https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOpQrStUvWxYz/edit#gid=123456
#   - GOOGLE_SHEETS_ID é o trecho entre "/d/" e "/edit" -> 1AbCdEfGhIjKlMnOpQrStUvWxYz
#   - GOOGLE_SHEETS_GID é o número após "gid=" (use "0" para a primeira aba) -> 123456
#
# Obs.: A planilha deve estar compartilhada como "Qualquer pessoa com o link (Leitor)".
#       Se GOOGLE_SHEETS_CSV_URL estiver preenchida, ela terá prioridade sobre ID/GID.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_GID=0

# ------------------------------------------------------------------------------
# Timeout das requisições HTTP ao Google Sheets (em segundos)
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_TIMEOUT=15

# ------------------------------------------------------------------------------
# Data de corte da sincronização (formato YYYY-MM-DD ou DD/MM/YYYY)
# ------------------------------------------------------------------------------
# Somente registros novos com data igual ou posterior a esta data serão puxados
# do Google Sheets para o banco local (registros já existentes ou removidos no
# banco local nunca são sobrescritos nem reimportados).
GOOGLE_SHEETS_MIN_DATE=2026-11-23

# ==============================================================================
# Configurações de Backup Automático Semanal e Envio por E-mail (SMTP)
# ==============================================================================
# Servidor SMTP (ex.: smtp.gmail.com na porta 465 com SSL ativo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true

# Conta remetente usada para enviar os backups.
# No Gmail, é necessário ativar a Verificação em 2 etapas na conta e gerar uma
# Senha de App (16 letras, sem espaços) para preencher em SMTP_PASSWORD.
SMTP_USER=
SMTP_PASSWORD=

# Timeout da conexão SMTP em segundos
SMTP_TIMEOUT=30

# E-mail(s) de destino que receberão o backup semanal.
# Aceita um ou mais endereços separados por vírgula (ex.: admin@exemplo.org,ti@exemplo.org).
BACKUP_EMAIL_DESTINO=

# Quantidade máxima de backups automáticos mantidos localmente (os mais antigos são removidos)
BACKUP_AUTO_RETENCAO=8
